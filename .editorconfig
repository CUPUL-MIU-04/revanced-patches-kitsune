# EditorConfig for ReVanced Patches Kitsune
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = disabled
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{gradle,gradle.kts}]
ij_continuation_indent_size = 8

[build.gradle.kts]
ij_kotlin_imports_layout = '*'

# Configuración específica para scripts de prueba
[src/test/**]
ij_kotlin_packages_to_use_import_on_demand = org.junit.jupiter.,org.mockito.

# Excepciones para archivos generados
[*.{bin,class,jar,war,ear}]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = ignore