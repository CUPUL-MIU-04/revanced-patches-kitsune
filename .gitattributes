# Configuración de finales de línea (line endings)
#######################################################################
# Scripts Unix/Linux
/gradlew        text eol=lf
/gradlew.bat    text eol=crlf  # Aunque es .bat, Gradle lo genera con LF

# Scripts Windows
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Archivos de texto
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.toml          text eol=lf

# Configuración para archivos fuente
#######################################################################
*.kt            text eol=lf
*.kts           text eol=lf
*.java          text eol=lf

# Archivos binarios (Git no debe intentar diffs/merges)
#######################################################################
*.class         binary
*.dll           binary
*.exe           binary
*.jar           binary
*.so            binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary

# Configuración especial para GitHub
#######################################################################
# Archivos grandes (usar Git LFS si son frecuentes)
*.zip           filter=lfs diff=lfs merge=lfs -text
*.gz            filter=lfs diff=lfs merge=lfs -text

# Diferenciación entre tipos de archivos
#######################################################################
# Identificar scripts shell
*.sh            text eol=lf

# Identificar archivos de configuración
.editorconfig   text
.gitattributes  text
.gitignore      text

# Configuración para builds de Android
#######################################################################
# Asegurar que los archivos de recursos mantengan su formato
res/**/*.xml    text
assets/**/*     -text

# Configuración específica para el proyecto Kitsune
#######################################################################
# Tratar los archivos de parches como texto
patches/**/*.kt text
patches/**/*.kts text

# Para archivos de parches personalizados
*.rvpk          binary